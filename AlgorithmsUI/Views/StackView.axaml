<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AlgorithmsUI.Controls"
             x:Class="AlgorithmsUI.Views.StackView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="390,*" Margin="24,20,24,24">
        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="1 часть. Структура данных Стек (LIFO)" />
            <TextBlock Classes="subtitle"
                       Text="Реализация на базе собственного связного списка. Добавление (Push) и извлечение (Pop) выполняются с вершины за O(1). Поддерживаются последовательности операций из input.txt, перевод из инфиксной записи и вычисление постфиксных выражений." />
        </StackPanel>

        <!-- Left Column: Controls & Inputs -->
        <DockPanel Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0,0,0,12">
                    <!-- Tab Switcher -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="РЕЖИМ РАБОТЫ" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                <Button x:Name="TabOpsBtn" Content="Операции" Classes="wide accent" />
                                <Button Grid.Column="1" x:Name="TabCalcBtn" Content="Калькулятор" Classes="wide" />
                                <Button Grid.Column="2" x:Name="TabBenchBtn" Content="Замер" Classes="wide" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 1: OPERATIONS (input.txt) -->
                    <StackPanel x:Name="PanelOperations" Spacing="12">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ПОСЛЕДОВАТЕЛЬНОСТЬ ОПЕРАЦИЙ (INPUT.TXT)" />
                                <TextBlock Classes="hint" Text="1,x — Push(x)  |  2 — Pop()  |  3 — Top()  |  4 — IsEmpty()  |  5 — Print()" />
                                <TextBox x:Name="CommandsInput" Text="3 4 1,56 1,7 1,cat 2 5 4" TextWrapping="Wrap" AcceptsReturn="True" Height="64" />
                                
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="LoadFileBtn" Content="Из input.txt" Classes="wide" />
                                    <Button Grid.Column="1" x:Name="SaveFileBtn" Content="В input.txt" Classes="wide" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="PresetDocBtn" Content="Пример из задания" Classes="wide" />
                                    <Button Grid.Column="1" x:Name="PresetRandomBtn" Content="Случайный набор" Classes="wide" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Button x:Name="RunAllBtn" Content="Старт (Авто)" Classes="wide accent" ToolTip.Tip="Пробел" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="StepBtn" Content="Шаг вперед" Classes="wide" ToolTip.Tip="→" />
                                    <Button Grid.Column="1" x:Name="ResetBtn" Content="Сначала" Classes="wide" ToolTip.Tip="R" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ПОКАЗАТЕЛИ" />
                                <controls:StatRow x:Name="StatCurrentSize" Label="Элементов в стеке" Value="0" />
                                <controls:StatRow x:Name="StatTopElem" Label="Вершина" Value="—" />
                                <controls:StatRow x:Name="StatStepProgress" Label="Текущий шаг" Value="0 / 0" />
                                <controls:StatRow x:Name="StatExecTime" Label="Время выполнения" Value="—" />
                                <controls:StatRow x:Name="StatComplexity" Label="Теоретическая сложность" Value="O(1)" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="0">
                            <DockPanel MinHeight="140" MaxHeight="220">
                                <TextBlock DockPanel.Dock="Top" Classes="section" Text="ЖУРНАЛ ОПЕРАЦИЙ" Margin="16,12,16,4" />
                                <ListBox x:Name="OpsLogList" Classes="log" Background="Transparent" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- PANEL 2: POSTFIX & INFIX -->
                    <StackPanel x:Name="PanelCalculator" Spacing="12" IsVisible="False">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ПЕРЕВОД: ИНФИКС ➔ ПОСТФИКС" />
                                <TextBlock Classes="hint" Text="Человекопонятная формула (поддерживает +, -, *, :, ^, sqrt, sin, cos, ln, скобки)" />
                                <TextBox x:Name="InfixInput" Text="( 7 + 8 ) : ( 3 + 2 )" />
                                <Button x:Name="ConvertInfixBtn" Content="Перевести в постфикс" Classes="wide accent" />
                                <TextBox x:Name="ConvertedPostfixResult" IsReadOnly="True" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ВЫЧИСЛЕНИЕ ПОСТФИКСНОЙ ЗАПИСИ" />
                                <TextBlock Classes="hint" Text="Постфиксные токены через пробел (например: 7 8 + 3 2 + :)" />
                                <TextBox x:Name="PostfixInput" Text="7 8 + 3 2 + :" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="EvalPostfixBtn" Content="Вычислить (Авто)" Classes="wide accent" />
                                    <Button Grid.Column="1" x:Name="EvalStepBtn" Content="По шагам →" Classes="wide" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="РЕЗУЛЬТАТ ВЫЧИСЛЕНИЯ" />
                                <controls:StatRow x:Name="StatCalcResult" Label="Значение выражения" Value="—" />
                                <controls:StatRow x:Name="StatCalcStep" Label="Шаг вычисления" Value="—" />
                                <controls:StatRow x:Name="StatCalcTime" Label="Время расчёта" Value="—" />
                                <controls:StatRow x:Name="StatCalcComplexity" Label="Оценка сложности" Value="O(n) время / O(n) память" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="0">
                            <DockPanel MinHeight="140" MaxHeight="280">
                                <TextBlock DockPanel.Dock="Top" Classes="section" Text="ХОД ВЫЧИСЛЕНИЙ" Margin="16,12,16,4" />
                                <ListBox x:Name="CalcLogList" Classes="log" Background="Transparent" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- PANEL 3: PERFORMANCE BENCHMARK -->
                    <StackPanel x:Name="PanelBenchmark" Spacing="12" IsVisible="False">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ПАРАМЕТРЫ ЗАМЕРА" />
                                <TextBlock Classes="hint" Text="Генерация больших наборов команд input.txt с замером времени" />
                                
                                <TextBlock Classes="label" Text="Число операций" />
                                <ComboBox x:Name="BenchCountCombo" SelectedIndex="1">
                                    <ComboBoxItem Content="1 000 операций" />
                                    <ComboBoxItem Content="10 000 операций" />
                                    <ComboBoxItem Content="50 000 операций" />
                                    <ComboBoxItem Content="100 000 операций" />
                                    <ComboBoxItem Content="500 000 операций" />
                                </ComboBox>

                                <TextBlock Classes="label" Text="Состав операций" />
                                <ComboBox x:Name="BenchMixCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Смешанный (50% Push / 50% Pop)" />
                                    <ComboBoxItem Content="Только Push (100%)" />
                                    <ComboBoxItem Content="80% Push / 20% Pop" />
                                </ComboBox>

                                <Button x:Name="RunBenchBtn" Content="Запустить тест скорости" Classes="wide accent" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="РЕЗУЛЬТАТЫ ЗАМЕРА" />
                                <controls:StatRow x:Name="StatBenchOps" Label="Выполнено операций" Value="—" />
                                <controls:StatRow x:Name="StatBenchTime" Label="Общее время" Value="—" />
                                <controls:StatRow x:Name="StatBenchSpeed" Label="Скорость (оп/сек)" Value="—" />
                                <controls:StatRow x:Name="StatBenchAvg" Label="Среднее время операции" Value="—" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Right Column: Canvas / Visualizer -->
        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <Panel>
                <controls:StackCanvas x:Name="VisualCanvas" Margin="16" />
                <controls:BenchmarkCanvas x:Name="BenchCanvas" Margin="16" IsVisible="False" />
            </Panel>
        </Border>
    </Grid>
</UserControl>
