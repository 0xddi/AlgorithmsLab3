<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AlgorithmsUI.Controls"
             x:Class="AlgorithmsUI.Views.ApplicationsView">
    <Grid RowDefinitions="Auto,*" ColumnDefinitions="390,*" Margin="24,20,24,24">
        <!-- Header -->
        <StackPanel Grid.ColumnSpan="2" Spacing="4" Margin="0,0,0,16">
            <TextBlock Classes="h1" Text="5 часть. Применение динамических структур" />
            <TextBlock Classes="subtitle"
                       Text="Реальные сценарии использования: Список для сложения бесконечно длинных чисел столбиком, Стек для системы отмены/повтора (Undo/Redo), Очередь для карусельного планировщика процессов ОС (Round Robin), Бинарное дерево для разбора постфиксных выражений." />
        </StackPanel>

        <!-- Left Column: Controls & Panels -->
        <DockPanel Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0,0,0,12">
                    <!-- Tab Switcher -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section" Text="ВЫБОР ПРИМЕНЕНИЯ" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                <Button x:Name="TabAdderBtn" Content="Длинные числа" Classes="wide accent" />
                                <Button Grid.Column="1" x:Name="TabEditorBtn" Content="Undo / Redo" Classes="wide" />
                                <Button Grid.Column="2" x:Name="TabRobinBtn" Content="Round Robin" Classes="wide" />
                                <Button Grid.Column="3" x:Name="TabTreeBtn" Content="Дерево выражений" Classes="wide" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 1: LONG NUMBER ADDER -->
                    <StackPanel x:Name="PanelAdder" Spacing="12">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="СЛОЖЕНИЕ ДЛИННЫХ ЧИСЕЛ (СПИСОК)" />
                                <TextBlock Classes="hint" Text="Цифры хранятся в связном списке от младших к старшим: O(max(N,M))" />

                                <TextBlock Classes="label" Text="Число A:" />
                                <TextBox x:Name="AdderNumAInput" Text="99999999999999999999999999" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Text="Число B:" />
                                <TextBox x:Name="AdderNumBInput" Text="1" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="AdderRunBtn" Content="Старт (Авто)" Classes="wide accent" />
                                    <Button Grid.Column="1" x:Name="AdderStepBtn" Content="Шаг →" Classes="wide" />
                                </Grid>
                                <Button x:Name="AdderResetBtn" Content="Сбросить сложение" Classes="wide" />

                                <TextBlock Classes="section" Text="ПРЕСЕТЫ ЧИСЕЛ" Margin="0,4,0,0" />
                                <Button x:Name="AdderPresetNinesBtn" Content="999...9 + 1 (Переносы)" Classes="wide" />
                                <Button x:Name="AdderPresetHugeBtn" Content="30-значные числа" Classes="wide" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ПОКАЗАТЕЛИ СЛОЖЕНИЯ" />
                                <controls:StatRow x:Name="StatAdderDigitsA" Label="Разрядов в числе A" Value="—" />
                                <controls:StatRow x:Name="StatAdderDigitsB" Label="Разрядов в числе B" Value="—" />
                                <controls:StatRow x:Name="StatAdderDigitsRes" Label="Разрядов в сумме" Value="—" />
                                <controls:StatRow x:Name="StatAdderTime" Label="Время сложения" Value="—" />
                                <controls:StatRow x:Name="StatAdderComplexity" Label="Сложность алгоритма" Value="O(max(N, M))" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="РЕЗУЛЬТАТ (СУММА)" />
                                <TextBox x:Name="AdderResultOutput" IsReadOnly="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: UNDO / REDO EDITOR -->
                    <StackPanel x:Name="PanelEditor" Spacing="12" IsVisible="False">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ТЕКСТОВЫЙ РЕДАКТОР С UNDO/REDO (СТЕК)" />
                                <TextBlock Classes="hint" Text="Два стека EditAction: стек отмен (Undo) и стек возвратов (Redo)" />

                                <TextBlock Classes="label" Text="Текущий текст документа:" />
                                <TextBox x:Name="EditorCurrentText" IsReadOnly="True" Height="70" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Text="Ввести текст (Type):" />
                                <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                                    <TextBox x:Name="EditorTypeInput" Text="Hello, world!" />
                                    <Button Grid.Column="1" x:Name="EditorTypeBtn" Content="Ввести" Classes="wide accent" />
                                </Grid>

                                <TextBlock Classes="label" Text="Удалить символов (Delete):" />
                                <Grid ColumnDefinitions="*,100" ColumnSpacing="8">
                                    <NumericUpDown x:Name="EditorDeleteCount" Minimum="1" Maximum="100" Value="3" />
                                    <Button Grid.Column="1" x:Name="EditorDeleteBtn" Content="Удалить" Classes="wide" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="EditorUndoBtn" Content="↶ Отменить (Undo)" Classes="wide" />
                                    <Button Grid.Column="1" x:Name="EditorRedoBtn" Content="↷ Повторить (Redo)" Classes="wide" />
                                </Grid>

                                <Button x:Name="EditorClearBtn" Content="Очистить редактор" Classes="wide" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="СОСТОЯНИЕ СТЕКОВ РЕДАКТОРА" />
                                <controls:StatRow x:Name="StatEditorUndoCount" Label="Действий в Undo стеке" Value="0" />
                                <controls:StatRow x:Name="StatEditorRedoCount" Label="Действий в Redo стеке" Value="0" />
                                <controls:StatRow x:Name="StatEditorLength" Label="Длина текущего текста" Value="0" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="EditorPresetHelloBtn" Content="Пример: Hello" Classes="wide" />
                            <Button Grid.Column="1" x:Name="EditorPresetTypingBtn" Content="Пример: Набор текста" Classes="wide" />
                        </Grid>

                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="СЛОЖНОСТЬ ОПЕРАЦИЙ" />
                                <TextBlock Classes="label" Text="• Type / Delete — O(1) push в стек отмен" />
                                <TextBlock Classes="label" Text="• Undo — O(1) pop из undo + push в redo" />
                                <TextBlock Classes="label" Text="• Redo — O(1) pop из redo + push в undo" />
                                <TextBlock Classes="hint" Text="Стеки анимируются на главном полотне справа: Ctrl+Z — отменить, Ctrl+Y — повторить." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: ROUND ROBIN SCHEDULER -->
                    <StackPanel x:Name="PanelRobin" Spacing="12" IsVisible="False">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ДИСПЕТЧЕР ROUND ROBIN (ОЧЕРЕДЬ)" />
                                <TextBlock Classes="hint" Text="Процессы обслуживаются циклически квантами времени через MyQueue FIFO" />

                                <TextBlock Classes="label" Text="Квант времени (Quantum):" />
                                <Grid ColumnDefinitions="*,60" ColumnSpacing="10">
                                    <Slider x:Name="RobinQuantumSlider" Minimum="1" Maximum="10" Value="3" />
                                    <TextBlock Grid.Column="1" x:Name="RobinQuantumLabel" Text="3" Classes="stat-value" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="RobinRunBtn" Content="Запустить симуляцию" Classes="wide accent" />
                                    <Button Grid.Column="1" x:Name="RobinStepBtn" Content="По шагам →" Classes="wide" />
                                </Grid>
                                <Button x:Name="RobinResetBtn" Content="Сбросить (P1, P2, P3)" Classes="wide" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="СВОДНЫЕ МЕТРИКИ ПЛАНИРОВАНИЯ" />
                                <controls:StatRow x:Name="StatRobinTotalTime" Label="Общее время работы" Value="—" />
                                <controls:StatRow x:Name="StatRobinAvgWait" Label="Среднее время ожидания" Value="—" />
                                <controls:StatRow x:Name="StatRobinAvgTurnaround" Label="Среднее время оборота" Value="—" />
                                <controls:StatRow x:Name="StatRobinSlicesCount" Label="Всего переключений" Value="—" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="0">
                            <DockPanel MinHeight="140" MaxHeight="200">
                                <TextBlock DockPanel.Dock="Top" Classes="section" Text="ТАБЛИЦА ПРОЦЕССОВ" Margin="16,12,16,4" />
                                <ListBox x:Name="RobinProcessList" Classes="log" Background="Transparent" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 4: EXPRESSION TREE -->
                    <StackPanel x:Name="PanelTree" Spacing="12" IsVisible="False">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="section" Text="ПОСТФИКСНОЕ ВЫРАЖЕНИЕ (ДЕРЕВО)" />
                                <TextBlock Classes="hint" Text="Токены через пробел (+, -, *, /, :, ^, sqrt, sin, cos, ln)" />
                                <TextBox x:Name="TreePostfixInput" Text="7 8 + 3 2 + :" TextWrapping="Wrap" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="TreeBuildBtn" Content="Построить и вычислить" Classes="wide accent" ToolTip.Tip="Пробел" />
                                    <Button Grid.Column="1" x:Name="TreeStepBtn" Content="Шаг →" Classes="wide" ToolTip.Tip="→" />
                                </Grid>
                                <TextBlock Classes="hint" Text="«Шаг» строит дерево по одному токену: удобно разбирать алгоритм вручную." />

                                <TextBlock Classes="section" Text="ШАБЛОНЫ" Margin="0,4,0,0" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button x:Name="TreePresetDocBtn" Content="Пример задания" Classes="wide" />
                                    <Button Grid.Column="1" x:Name="TreePresetComplexBtn" Content="Со степенями" Classes="wide" />
                                </Grid>
                                <Button x:Name="TreePresetFuncBtn" Content="С функциями (sqrt, sin)" Classes="wide" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="РЕЗУЛЬТАТЫ И ОБХОДЫ ДЕРЕВА" />
                                <controls:StatRow x:Name="TreeStatResult" Label="Значение (Evaluate)" Value="—" />
                                <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,4" />

                                <TextBlock Classes="label" Text="Инфиксный обход (Infix со скобками):" />
                                <TextBox x:Name="TreeInfixResult" IsReadOnly="True" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Text="Префиксный обход (Prefix):" />
                                <TextBox x:Name="TreePrefixResult" IsReadOnly="True" TextWrapping="Wrap" />

                                <TextBlock Classes="label" Text="Постфиксный обход (Postfix):" />
                                <TextBox x:Name="TreePostfixResult" IsReadOnly="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ПАРАМЕТРЫ ДЕРЕВА" />
                                <controls:StatRow x:Name="TreeStatNodes" Label="Всего узлов в дереве" Value="—" />
                                <controls:StatRow x:Name="TreeStatDepth" Label="Максимальная глубина (высота)" Value="—" />
                                <controls:StatRow x:Name="TreeStatBuildTime" Label="Время расчёта" Value="—" />
                                <controls:StatRow x:Name="TreeStatComplexity" Label="Сложность обходов" Value="O(n) — 1 проход" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="0">
                            <DockPanel MinHeight="100" MaxHeight="160">
                                <TextBlock DockPanel.Dock="Top" Classes="section" Text="ЖУРНАЛ" Margin="16,12,16,4" />
                                <ListBox x:Name="TreeLogList" Classes="log" Background="Transparent" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Right Column: Context Canvas -->
        <Border Grid.Row="1" Grid.Column="1" Classes="canvas">
            <Panel>
                <controls:AdditionCanvas x:Name="AdderCanvas" Margin="16" />
                <controls:UndoRedoCanvas x:Name="EditorCanvas" Margin="16" IsVisible="False" />
                <controls:TimelineCanvas x:Name="TimelineCanvas" Margin="16" IsVisible="False" />
                <controls:TreeCanvas x:Name="TreeCanvas" Margin="16" IsVisible="False" />
            </Panel>
        </Border>
    </Grid>
</UserControl>